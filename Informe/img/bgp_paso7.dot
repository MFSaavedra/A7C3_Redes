
graph bgp_paso7 {
    graph [
        bgcolor="white",
        fontname="LM Roman 10",
        nodesep=1.1,
        ranksep=1.3,
        pad=0.3,
        splines=true,
        overlap=false
    ]

    node [
        shape=box,
        style="rounded,filled",
        fillcolor="#f2f2f2",
        color="#333333",
        fontname="LM Roman 10",
        fontsize=11,
        margin="0.15,0.10"
    ]

    edge [
        color="#333333",
        fontname="LM Roman 10",
        fontsize=8,
        penwidth=1.1
    ]

    r0 [label="R0\nAS 65000"]
    r1 [label="R1\nAS 65001"]
    r2 [label="R2\nAS 65002"]
    r3 [label="R3\nAS 65003\nAnuncia solo:\n192.168.3.0/24"]
    r4 [label="R4\nAS 65004\nAnuncia solo:\n192.168.4.0/24"]

    // Distribución vertical
    { rank=min; r0 }
    { rank=same; r1; r2 }
    { rank=same; r3; r4 }

    // Orden horizontal
    r1 -- r2 [style=invis, weight=100]
    r3 -- r4 [style=invis, weight=100]

    // R0 con R1 y R2
    r0 -- r1 [label="R0 → R1: 192.168.0.0/24\nR1 → R0: rutas conocidas"]
    r0 -- r2 [label="R0 → R2: 192.168.0.0/24\n(prepend)\nR2 → R0: rutas conocidas"]

    // Sesión entre R1 y R2
    r1 -- r2 [label="R1 ↔ R2: rutas conocidas", constraint=false]

    // Sesiones entre R1/R2 y R3/R4
    r1 -- r3 [label="R1 → R3: rutas conocidas\nR3 → R1: solo 3.0/24"]
    r2 -- r4 [label="R2 → R4: rutas conocidas\nR4 → R2: solo 4.0/24"]

    // Conexiones cruzadas
    r1 -- r4 [label="R1 → R4: rutas conocidas\nR4 → R1: solo 4.0/24", constraint=false]
    r2 -- r3 [label="R2 → R3: rutas conocidas\nR3 → R2: solo 3.0/24", constraint=false]

    // Sesión entre R3 y R4
    r3 -- r4 [label="R3 → R4: solo 3.0/24\nR4 → R3: solo 4.0/24", constraint=false]
}
